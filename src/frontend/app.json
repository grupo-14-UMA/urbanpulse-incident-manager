{
  "expo": {
    "name": "UrbanPulse",
    "slug": "urbanpulse",
    "scheme": "urbanpulse",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "UrbanPulse usa tu ubicación para proponer dónde está la incidencia que vas a registrar."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "UrbanPulse usa la cámara para tomar fotos de la incidencia.",
          "photosPermission": "UrbanPulse accede a tus fotos para adjuntarlas a la incidencia."
        }
      ]
    ]
  }
}

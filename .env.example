# Backend connection to the database
DB_HOST=localhost
DB_PORT=5432

# Shared by the backend and the official Postgres image
POSTGRES_DB=urbanpulse
POSTGRES_USER=urbanpulse
POSTGRES_PASSWORD=urbanpulse

# Backend HTTP port
SERVER_PORT=8080

# Host port for the Docker Compose management panel
MANAGEMENT_PANEL_PORT=8081

# Secret that signs the access tokens, at least 32 bytes. Required: the backend does not start
# without it. DEVELOPMENT-ONLY value: a real deployment must use its own random secret.
JWT_SECRET=dev-only-jwt-secret-change-me-in-any-deployment

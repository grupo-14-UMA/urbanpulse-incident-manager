# Backend connection to the database
DB_HOST=localhost
DB_PORT=5432

# Shared by the backend and the official Postgres image
POSTGRES_DB=urbanpulse
POSTGRES_USER=urbanpulse
POSTGRES_PASSWORD=urbanpulse

# Backend HTTP port
SERVER_PORT=8080

# Allowed browser origin for the management panel (Vite default)
MANAGEMENT_PANEL_ORIGIN=http://localhost:5173
